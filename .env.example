# ===== Local RAG — örnek konfigürasyon =====
# Bu dosyayı `.env` olarak kopyalayıp kendi değerlerinizle doldurun.
# .env dosyası git'e commit'lenmemelidir (zaten .gitignore'da).

# ----- Embedding -----
# Sentence-BERT modeli (Türkçe destekli multilingual model önerilir)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ----- ChromaDB -----
# Yerel persist dizini (göreli yol)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=personal_memory

# ----- LLM (Ollama) -----
# Ollama'nın çalıştığı host (varsayılan localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Kullanılacak model adı (önce `ollama pull <model>` ile indirin)
LLM_MODEL=llama3.2

# ----- Retrieval -----
# Hibrit skor ağırlıkları (similarity * SIM_WEIGHT + importance * IMP_WEIGHT)
RETRIEVAL_SIM_WEIGHT=0.7
RETRIEVAL_IMP_WEIGHT=0.3
# Geri çağrılacak top-k anı sayısı
RETRIEVAL_TOP_K=5

# ----- Memory yönetimi -----
# Düşük önem eşiği (bunun altındaki mesajlar TTL süresi sonunda silinir)
MEMORY_LOW_IMPORTANCE_THRESHOLD=0.3
# TTL süresi (gün)
MEMORY_TTL_DAYS=30

# ----- Loglama -----
LOG_LEVEL=INFO
